{
  "name": "awesome-journal",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "check": "npm run lint && npm run typecheck && npm run format:check",
    "fix": "npm run format && npm run lint -- --fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,mjs,cjs,css,json}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,mjs,cjs,css,json}\"",
    "db:up": "bash scripts/db-up.sh",
    "db:down": "bash scripts/db-down.sh",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "postinstall": "prisma generate",
    "dev:server2": "next dev -p 3002",
    "test": "playwright test",
    "test:e2e": "playwright test",
    "test:install": "playwright install chromium"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.2.5",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^1.41.0",
    "next": "16.3.4",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.87.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.6",
    "prisma": "^6.19.3",
    "prisma-erd-generator": "^3.2.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "allowScripts": {
    "0": "unrs-resolver",
    "1": "next",
    "2": "prisma",
    "3": "@prisma/client",
    "4": "@prisma/engines",
    "5": "esbuild",
    "6": "@tailwindcss/oxide",
    "unrs-resolver@1.12.2": true,
    "esbuild@0.28.2": true,
    "msgpackr-extract@3.0.4": true,
    "workerd@1.20260704.1": true,
    "prisma@6.19.3": true,
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "@prisma/engines-version@7.1.1-3.c2990dca591cba766e3b7ef5d9e8a84796e47ab7": true
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  }
}
